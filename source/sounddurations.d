private immutable int[char[4]] durationByTag;
shared static this(){
	int[char[4]] result;
	foreach(ref entry;referenceSoundDurations) result[entry.tag]=entry.duration;
	durationByTag=cast(immutable)result;
}

/// reference duration of a localized sound, or -1 if the sound is not localized
int referenceSoundDuration(char[4] tag){
	if(auto duration=tag in durationByTag) return *duration;
	return -1;
}
